#:include 'common.fypp'
#:set INTERFACE_NAME = 'elliptic_k'
#:set MODULE_NAME = INTERFACE_NAME + '_using_agm_fortran'
module ${MODULE_NAME}$
    !! A Fortran library for computing the complete elliptic integral of the first kind using AGM

#:for REAL_KIND in REAL_KINDS
    use, intrinsic :: iso_fortran_env, only: ${REAL_KIND}$
#:endfor

    use, intrinsic :: ieee_arithmetic, only: ieee_is_nan
    use, intrinsic :: ieee_arithmetic, only: ieee_positive_inf
    use, intrinsic :: ieee_arithmetic, only: ieee_quiet_nan
    use, intrinsic :: ieee_arithmetic, only: ieee_value

    use, non_intrinsic :: arithmetic_geometric_mean_fortran

    use, non_intrinsic :: elliptic_nome_fortran



    implicit none



    private

    public :: ${INTERFACE_NAME}$



#:include 'half_pi.fypp'

#:set MAXVAL_LEN = 0
#:for REAL_KIND in REAL_KINDS
    #:set MAXVAL_LEN = max( MAXVAL_LEN, len(REAL_KIND) )
#:endfor
#:for REAL_KIND in REAL_KINDS
    #:set REAL_KIND_LJUST = REAL_KIND.ljust(MAXVAL_LEN)
    real( ${REAL_KIND_LJUST}$ ), parameter :: mns_inv_pi_${REAL_KIND_LJUST}$ = -0.318309886183790671537767526745028724069_${REAL_KIND}$
#:endfor
#:del MAXVAL_LEN
#:del REAL_KIND_LJUST




    interface ${INTERFACE_NAME}$
    #:for REAL_KIND in REAL_KINDS
        module procedure :: ${INTERFACE_NAME}$_${REAL_KIND}$
    #:endfor
    end interface ${INTERFACE_NAME}$



    contains
#:for REAL_KIND in REAL_KINDS



    #:set FUNCTION_NAME = INTERFACE_NAME + '_' + REAL_KIND
    elemental function ${FUNCTION_NAME}$(k) result(integral)

        real(${REAL_KIND}$), intent(in) :: k !! elliptic modulus \( k \)



        real(${REAL_KIND}$) :: integral ! return value



        real(${REAL_KIND}$) :: abs_k
        real(${REAL_KIND}$) :: agm_k !! \( \text{AGM}( 1, { k }^{ \prime } ) \)
        real(${REAL_KIND}$) :: cmp_k !! \( { k }^{ \prime } := \sqrt{ 1 - { k }^{ 2 } } \)
        real(${REAL_KIND}$) :: nom_k !! nome \( q \) for elliptic integrals corresponding to modulus \( k \)
        real(${REAL_KIND}$) :: tmp



        if ( ieee_is_nan(k) ) then

            integral = ieee_value( x = k, class = ieee_quiet_nan )

            return

        end if



        abs_k = abs(k)



        if (abs_k .gt. 1.0_${REAL_KIND}$) then

            integral = ieee_value( x = k, class = ieee_quiet_nan )

        else if (abs_k .lt. 1.0_${REAL_KIND}$) then

            cmp_k = sqrt( (1.0_${REAL_KIND}$ - k) * (1.0_${REAL_KIND}$ + k) )

            if ( (k * k) .lt. 0.5_${REAL_KIND}$ ) then

                agm_k    = arithmetic_geometric_mean_kernel(1.0_${REAL_KIND}$, cmp_k)
                integral = half_pi_${REAL_KIND}$ / agm_k

            else

                agm_k    = arithmetic_geometric_mean_kernel(1.0_${REAL_KIND}$, k)
                tmp      = half_pi_${REAL_KIND}$ / agm_k
                nom_k    = elliptic_nome_auto(cmp_k)
                integral = mns_inv_pi_${REAL_KIND}$ * tmp * log(nom_k)

            end if

        else

            integral = ieee_value( x = k, class = ieee_positive_inf )

        end if

    end function ${FUNCTION_NAME}$
    #:del FUNCTION_NAME
#:endfor

end module ${MODULE_NAME}$
